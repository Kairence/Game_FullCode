## ===========================================
## ServUO (Kairence Shard) .gitignore
## ===========================================

# ------------------------------------------
# Build output directories
# ------------------------------------------
/Ultima/bin/
/Ultima/obj/
/Server/bin/
/Server/obj/
/Scripts/bin/
/Scripts/obj/
/Scripts/Output/

# ------------------------------------------
# Root-level build output DLLs
# dotnet build -o . outputs all dependency DLLs here
# ------------------------------------------
/*.dll
# Native dependencies (keep these)
!/zlibwapi32.dll
!/zlibwapi64.dll
# Legacy debug build dependency (keep)
!/Microsoft.CodeDom.Providers.DotNetCompilerPlatform.dll

# GUID-prefixed Ultima.dll build artifacts
*_Ultima.dll

# ------------------------------------------
# .NET build metadata
# ------------------------------------------
*.deps.json
*.runtimeconfig.json

# ------------------------------------------
# Localization resource directories
# (dotnet build output for Microsoft.CodeAnalysis)
# ------------------------------------------
/cs/
/de/
/es/
/fr/
/it/
/ja/
/ko/
/pl/
/pt-BR/
/ru/
/tr/
/zh-Hans/
/zh-Hant/

# ------------------------------------------
# Runtime-specific directories
# ------------------------------------------
/runtimes/

# ------------------------------------------
# Debug symbols & executables
# ------------------------------------------
*.pdb
*.exe
*.exe.mdb
*.mdb

# ------------------------------------------
# Visual Studio / IDE
# ------------------------------------------
/.vs/
*.suo
*.user
*.csproj.user
*.DotSettings.user
*.sln.DotSettings.user

# ------------------------------------------
# JetBrains Rider / IntelliJ
# ------------------------------------------
.idea/

# ------------------------------------------
# VS Code (keep shared settings)
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# ServUO runtime data (generated at runtime)
# ------------------------------------------
/Saves*/
/Logs/
/Backups/
/Honesty/
/Web/
/Docs/
/Reports/
/VitaNexCore/
/TheBox/
/Third Backup/

# ------------------------------------------
# ServUO runtime-generated files
# ------------------------------------------
/staffHistory.xml
/reportHistory.xml
/firewall.cfg
*.log
*.bin

# ------------------------------------------
# Native random number generator (platform-specific)
# ------------------------------------------
/drng64.dll
/drng32.dll
/libdrng.so

# ------------------------------------------
# Windows shortcuts & old configs
# ------------------------------------------
*.lnk
*.config
!/Server/app.config
!.config/

# ------------------------------------------
# Shell scripts (generated by Makefile)
# ------------------------------------------
*.sh
!/setup.sh

# ------------------------------------------
# Archives inside Scripts
# ------------------------------------------
Scripts/**/*.zip

# ------------------------------------------
# OS-specific
# ------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------
# Tool / AI assistant directories
# ------------------------------------------
/.claude/
/.omc/
/.serena/
CLAUDE.md

# ------------------------------------------
# Misc
# ------------------------------------------
*.ini
git_upload.bat

# ------------------------------------------
# Negation rules (keep these tracked)
# ------------------------------------------
!/Data/*
!/bin/roslyn/*
